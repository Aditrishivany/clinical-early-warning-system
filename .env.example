# ══════════════════════════════════════════════════════
#  ClinicalAI Early Warning System — Environment Config
#  Copy this file to .env and fill in the values.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────
APP_NAME=Clinical Early Warning System
APP_VERSION=1.0.0
APP_ENV=production          # development | production
DEBUG=false

# ── API Server ────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=80            # host port mapped to nginx container

# ── Database ─────────────────────────────────────────
# SQLite (default — path inside Docker volume)
DATABASE_URL=sqlite:////app/data/clinical.db
# PostgreSQL example (uncomment to use):
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/clinical

# ── Security ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_64_char_hex_secret

# JWT — 8 hours by default (480 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ──────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173

# ── Groq AI (LLM for RAG / Chat) ─────────────────────
# Get your key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR

# ── Hospital ──────────────────────────────────────────
HOSPITAL_NAME=City General Hospital

# ── Frontend build (used by docker-compose build args) ──
VITE_API_BASE=http://localhost:8000/api/v1
